# Server
PORT=5000
NODE_ENV=development

# Database
# Either set DATABASE_URL (used as-is, e.g. for Render) ...
# DATABASE_URL=
# ... or the individual variables below (used when DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ges_db
DB_USER=postgres
DB_PASSWORD=changeme

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Bootstrap admin account (used once by `pnpm seed:admin`)
SEED_ADMIN_EMAIL=admin@ges.gov.gh
SEED_ADMIN_PASSWORD=change_this_password

# Email verification links
APP_BASE_URL=http://localhost:5173

# SendGrid (optional — if unset, verification codes are logged to the console instead of emailed)
# Get an API key at sendgrid.com. SENDGRID_FROM must be an address you've
# verified in SendGrid (Settings -> Sender Authentication).
SENDGRID_API_KEY=
SENDGRID_FROM=

# Hyperledger Fabric — GES Network (optional; leave FABRIC_CRYPTO_PATH empty to run in simulation mode)
# See README.md Section 12.3 and ges_final_year_fabric/README.md for how to generate this.
FABRIC_CRYPTO_PATH=
FABRIC_CHANNEL=geschannel
FABRIC_CHAINCODE=ges-verify
FABRIC_GES_PEER=localhost:7051
FABRIC_GES_PEER_HOST=peer0.ges.ges.edu.gh
